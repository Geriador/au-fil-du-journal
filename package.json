{
  "name": "au-fil-du-journal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Dialogue pédagogique documenté autour du Journal d’Anne Frank",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:documentaire": "node --test tests/dialogue.test.mjs",
    "test:serveur": "node --test tests/server.test.mjs",
    "server:check": "wrangler deploy --dry-run",
    "server:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "5.20260926.0-alpha",
    "wrangler": "4.143.0"
  }
}
