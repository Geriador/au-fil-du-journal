{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "au-fil-du-journal-dialogue",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-28",
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "CLASSROOM", "class_name": "Classroom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Classroom"] }],
  "vars": {
    "ENABLE_AI": "false",
    "ALLOWED_ORIGINS": "https://geriador.github.io",
    "DAILY_REQUEST_LIMIT": "1800",
    "MONTHLY_REQUEST_LIMIT": "12000",
    "MONTHLY_BUDGET_CENTS": "1000",
    "SESSION_REQUEST_LIMIT": "100",
    "MAX_CONCURRENT_REQUESTS": "80"
  }
}
